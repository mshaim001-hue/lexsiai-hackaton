  "delta_logp_probe": {
    "contexts": "same four train prefixes",
    "metric": "logp(REF) - logp([) at first divergence",
    "when": [
      "before_training",
      "after_training"
    ]
  },
  "eval": {
    "matrix": "artifacts/task-5-14 d0–d5 × {100,101} (12 episodes)",
